# Runtime
# Use "development" locally. Production must set NODE_ENV=production.
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# PlainVoice API URLs
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local-only development auth bypass
# These must stay false in production. The API also ignores DEV_AUTH_BYPASS
# unless NODE_ENV is not production and both API URLs point to localhost.
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Vapi.ai
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=

# Twilio voice/SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cal.com and SMS follow-up settings are stored per organization in the app.
