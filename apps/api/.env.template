# ============================================================
# PlainVoice — API Environment
# Copy this file to apps/api/.env and fill in values.
# NEVER commit .env to git.
# ============================================================

# ─── SUPABASE (required for all API features) ───────────────
# Get from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── VAPI (required for agent CRUD + webhooks) ──────────────
# Get from: https://dashboard.vapi.ai → Account → API Keys
VAPI_PRIVATE_KEY=...

# Set this to any random string. Then add the same string in:
# Vapi dashboard → Settings → Server URL → Secret
# Leave blank to skip webhook signature validation during local testing.
VAPI_WEBHOOK_SECRET=

# ─── STRIPE (not needed for Blocks A–C — leave blank) ───────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── TWILIO (not needed until phone provisioning — leave blank) ─
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
