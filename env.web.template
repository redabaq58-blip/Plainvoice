# ============================================================
# PlainVoice — Web App Environment
# Copy this file to apps/web/.env.local and fill in values.
# NEVER commit .env.local to git.
# ============================================================

# ─── SUPABASE (required for all features) ──────────────────
# Get from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── VAPI (required for agent creation + browser calls) ─────
# Get from: https://dashboard.vapi.ai → Account → API Keys
NEXT_PUBLIC_VAPI_PUBLIC_KEY=pk_...

# ─── INTERNAL (keep as-is for local dev) ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── STRIPE (not needed for Blocks A–C — leave blank) ───────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
